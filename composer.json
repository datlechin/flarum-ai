{
    "name": "datlechin/flarum-ai",
    "description": "AI provider toolkit for Flarum. Text generation, embeddings, moderation, with a self-declaring provider registry.",
    "keywords": [
        "flarum",
        "ai",
        "llm",
        "embeddings",
        "moderation",
        "openai",
        "anthropic",
        "gemini"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0.0-beta.5",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "flarum/testing": "^2.0"
    },
    "authors": [
        {
            "name": "Ngo Quoc Dat",
            "email": "datlechin@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/datlechin/flarum-ai",
        "issues": "https://github.com/datlechin/flarum-ai/issues"
    },
    "homepage": "https://github.com/datlechin/flarum-ai",
    "autoload": {
        "psr-4": {
            "Datlechin\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datlechin\\Ai\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "AI",
            "category": "feature",
            "icon": {
                "name": "fas fa-brain",
                "color": "#fff",
                "backgroundColor": "#4A90E2"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:setup": "@php -r \"echo \\\"No integration setup required.\\n\\\";\""
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:setup": "No-op placeholder for CI compatibility; this release ships unit tests only."
    }
}
