{
    "name": "datlechin/flarum-ai",
    "description": "Connect Flarum to OpenAI, Anthropic, Gemini or any OpenAI-compatible API, for other extensions to generate text with.",
    "keywords": [
        "flarum",
        "ai",
        "llm",
        "openai",
        "anthropic",
        "gemini",
        "openrouter",
        "ollama"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/datlechin/flarum-ai",
    "authors": [
        {
            "name": "Ngo Quoc Dat",
            "email": "datlechin@gmail.com",
            "homepage": "https://nqd.vn",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/datlechin/flarum-ai/issues",
        "source": "https://github.com/datlechin/flarum-ai"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/datlechin"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "guzzlehttp/guzzle": "^7.7"
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Datlechin\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datlechin\\Ai\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "AI",
            "category": "feature",
            "icon": {
                "name": "fas fa-wand-magic-sparkles",
                "color": "#fff",
                "backgroundColor": "#6d4aff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": false,
                "js": true,
                "jsCommon": false,
                "css": false,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": [
            "@php tests/phpstan-setup.php",
            "phpstan analyse"
        ],
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    }
}
